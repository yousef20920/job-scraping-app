# Environment Variables Template
# Copy this file to .env and fill in your values

# GitHub Configuration (for local testing)
# GITHUB_TOKEN=your_github_personal_access_token
# GITHUB_REPOSITORY=username/repo-name

# OpenAI API Key (optional - for AI features)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Optional ever-jobs API integration for broader company and role coverage
# Example: http://localhost:3001
# EVER_JOBS_API_URL=
# EVER_JOBS_API_KEY=

# Optional Gmail SMTP email notifications
# For Gmail, use your full Gmail address and a Google app password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com
# ENABLE_EMAIL_NOTIFICATIONS=true

# Set this for safe local runs that should not commit, push, or update issues
# SKIP_GITHUB_INTEGRATION=true

# Note: In GitHub Actions, these are automatically configured as secrets
# and don't need to be set in .env
