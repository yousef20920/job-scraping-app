# Environment Variables Template
# Copy this file to .env and fill in your values

# GitHub Configuration (for local testing)
# GITHUB_TOKEN=your_github_personal_access_token
# GITHUB_REPOSITORY=username/repo-name

# AI is disabled by default. Turn it on only if you explicitly want analysis.
# ENABLE_AI_ANALYSIS=true
# OPENAI_API_KEY=sk-...

# ever-jobs is disabled by default. Turn it on only if you want extra sources.
# ENABLE_EVER_JOBS=true
# EVER_JOBS_API_URL=
# EVER_JOBS_API_KEY=

# Keep only jobs posted within the last N hours. Default is 24.
# JOB_POSTED_WITHIN_HOURS=24

# Optional Gmail SMTP email notifications
# For Gmail, use your full Gmail address and a Google app password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com
# ENABLE_EMAIL_NOTIFICATIONS=false
# Emails are sent inline only; no report attachments are included.

# Set this for safe local runs that should not commit, push, or update issues
# SKIP_GITHUB_INTEGRATION=true

# Note: In GitHub Actions, these are automatically configured as secrets
# and don't need to be set in .env
